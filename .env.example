# Copy this file's variable names into Netlify Site Settings -> Environment
# Variables. Nothing here is required for the app to work - without them the
# DTR app runs exactly as it does today, with manually-entered tracking
# numbers and no live carrier status.

# Enables live UPS tracking directly through UPS's own free Tracking API -
# no paid plan needed. Preferred over Shippo for UPS shipments when both
# are set. Register at https://developer.ups.com, create an app, and add the
# "Tracking API" product to it to get these.
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=

# Enables live FedEx tracking directly through FedEx's own free Track API -
# no paid plan needed, same idea as UPS above. Preferred over Shippo for
# FedEx shipments when both are set. Register at
# https://developer.fedex.com, create a project, and add the "Track API" to
# it to get these.
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=

# Fallback: enables live carrier tracking via Shippo (also free, no paid
# plan or shipping labels through them required) for carriers that don't
# have a direct integration above (USPS, DHL) - not needed at all if you
# only ship UPS/FedEx. Get an API key at
# https://apps.goshippo.com/settings/api ("API Token", the live one, not
# "Test Token").
SHIPPO_API_KEY=

# Optional: only used to verify incoming /api/track-webhook requests really
# came from your Shippo account (Shippo doesn't sign webhook payloads, so
# this is a shared secret you make up yourself). If set, append
# ?secret=<this value> to the webhook URL you register in Shippo's
# dashboard (Settings -> Webhooks -> track_updated event) pointing at
# https://<your-netlify-domain>/api/track-webhook. This webhook is optional
# either way - the daily scheduled sweep and "Refresh Status"/"Refresh All"
# already keep tracking current without it, this just makes updates
# near-instant instead.
SHIPPO_WEBHOOK_SECRET=

# Enables the "Ask AI" page. Get a key from https://aistudio.google.com
# (Google AI Studio -> Get API Key). Free tier is generous for this volume
# of use.
GEMINI_API_KEY=

# Optional: which Gemini model to use. Defaults to gemini-flash-latest
# (Google's rolling alias for their current recommended fast model) if
# unset, so it won't go stale the way a hardcoded version eventually does.
# Set this if you want to pin a specific version instead.
GEMINI_MODEL=

# Enables "Look up customer" pulling contact info from Zendesk by ticket ID.
# Create an API token in Zendesk Admin Center -> Apps and integrations ->
# APIs -> Zendesk API -> Add API token. ZENDESK_EMAIL is the email address
# of the account that generated the token.
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# Enables "Look up customer" pulling contact info from Shopify by order
# number. SHOPIFY_STORE_DOMAIN + SHOPIFY_ADMIN_TOKEN are the two that matter
# long-term - see SETUP.md for how to get SHOPIFY_ADMIN_TOKEN, which as of
# this account requires a one-time OAuth install (via /api/shopify-install)
# rather than a simple "reveal token" button.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=

# Only needed temporarily, to run the one-time OAuth install at
# /api/shopify-install. These come from the Shopify dev dashboard app's
# Settings page (Client ID / Secret). Safe to remove after you've copied out
# SHOPIFY_ADMIN_TOKEN, though there's no harm leaving them.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Optional overrides. The app already has the current Supabase project URL
# and anon key embedded in index.html and netlify/functions/utils/shared.js -
# only set these if you rotate the anon key and want the functions to pick up
# the new one without editing code.
SUPABASE_URL=
SUPABASE_ANON_KEY=

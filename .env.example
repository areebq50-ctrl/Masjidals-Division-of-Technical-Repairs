# Copy this file's variable names into Netlify Site Settings -> Environment
# Variables. Nothing here is required for the app to work - without them the
# DTR app runs exactly as it does today, with manually-entered tracking
# numbers and no live carrier status.

# Enables live UPS tracking directly through UPS's own free Tracking API -
# no paid plan needed. Preferred over AfterShip for UPS shipments when both
# are set. Register at https://developer.ups.com, create an app, and add the
# "Tracking API" product to it to get these.
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=

# Enables live carrier tracking via AfterShip for non-UPS carriers (or UPS if
# UPS_CLIENT_ID/SECRET aren't set). Sign up at aftership.com, create an API
# key under Settings -> API Keys, and paste it here.
AFTERSHIP_API_KEY=

# Optional but recommended once AFTERSHIP_API_KEY is set: verifies that
# incoming /api/track-webhook requests really came from AfterShip. Find this
# under AfterShip -> Settings -> Webhooks after you create the webhook
# pointing at https://<your-netlify-domain>/api/track-webhook. Note: this
# webhook only applies to AfterShip-tracked shipments - UPS direct tracking
# has no webhook, it relies on the "Refresh Status" button and the daily
# scheduled sweep instead.
AFTERSHIP_WEBHOOK_SECRET=

# Enables the "Ask AI" page. Get a key from https://aistudio.google.com
# (Google AI Studio -> Get API Key). Free tier is generous for this volume
# of use.
GEMINI_API_KEY=

# Optional: which Gemini model to use. Defaults to gemini-2.0-flash (fast,
# cheap, large context window) if unset.
GEMINI_MODEL=

# Enables "Look up customer" pulling contact info from Zendesk by ticket ID.
# Create an API token in Zendesk Admin Center -> Apps and integrations ->
# APIs -> Zendesk API -> Add API token. ZENDESK_EMAIL is the email address
# of the account that generated the token.
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# Enables "Look up customer" pulling contact info from Shopify by order
# number. Create a custom app in Shopify Admin -> Settings -> Apps and sales
# channels -> Develop apps, grant it the read_orders scope only, install it,
# and copy the Admin API access token.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=

# Optional overrides. The app already has the current Supabase project URL
# and anon key embedded in index.html and netlify/functions/utils/shared.js -
# only set these if you rotate the anon key and want the functions to pick up
# the new one without editing code.
SUPABASE_URL=
SUPABASE_ANON_KEY=
